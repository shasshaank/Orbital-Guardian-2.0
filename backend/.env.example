CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 for deterministic local demonstrations using validated bundled data.
ORBITAL_OFFLINE=0
# Optional: defaults to backend/data/runtime; must be writable.
# ORBITAL_CACHE_DIR=/tmp/orbital-cache
# On-demand provider refresh interval, seconds; values below 7200 are clamped.
# Browser refresh reuses the provider cache; it never forces a download.
ORBITAL_REFRESH_SECONDS=7200

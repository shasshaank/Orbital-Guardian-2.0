{
  "name": "orbital-guardian-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.15.0",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "test": "vitest",
    "lint": "eslint src benchmarks --ext .js,.jsx",
    "benchmark:browser": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "benchmark:build": "vite build --config benchmarks/vite.config.mjs",
    "test:ci": "vitest run"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:jsx-a11y/recommended"
    ],
    "env": {
      "browser": true,
      "es2022": true,
      "jest": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/prop-types": "off",
      "react/no-unknown-property": "off",
      "no-unused-vars": [
        "error",
        {
          "ignoreRestSiblings": true
        }
      ]
    },
    "globals": {
      "vi": "readonly"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
